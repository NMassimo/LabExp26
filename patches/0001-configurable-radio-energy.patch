+package energy
+
+import (
+	"encoding/json"
+	"math"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	. "github.com/openthread/ot-ns/types"
+)
+
+func testModel() Model {
+	return Model{Name: "test", DisabledMW: 0.1, SleepMW: 1, RxMW: 5,
+		Tx: []TxPoint{{DBm: -20, MW: 10}, {DBm: 0, MW: 30}}}
+}
+
+func closeTo(t *testing.T, got, want float64) {
+	t.Helper()
+	if math.Abs(got-want) > 1e-12 {
+		t.Fatalf("got %.15g, want %.15g", got, want)
+	}
+}
+
+func TestModelInterpolationAndValidation(t *testing.T) {
+	m := testModel()
+	for power, want := range map[int8]float64{-128: 10, -20: 10, -10: 20, 0: 30, 127: 30} {
+		closeTo(t, m.TxMW(power), want)
+	}
+	for _, bad := range []Model{
+		{}, {Name: "empty"},
+		{Name: "negative", Tx: []TxPoint{{0, -1}}},
+		{Name: "nan", RxMW: math.NaN(), Tx: m.Tx},
+		{Name: "inf", Tx: []TxPoint{{0, math.Inf(1)}}},
+		{Name: "range", Tx: []TxPoint{{128, 1}}},
+		{Name: "duplicate", Tx: []TxPoint{{0, 1}, {0, 2}}},
+		{Name: "unsorted", Tx: []TxPoint{{0, 1}, {-10, 2}}},
+	} {
+		if bad.Validate() == nil {
+			t.Fatalf("accepted invalid model: %+v", bad)
+		}
+	}
+	if LegacyModel().Validate() != nil {
+		t.Fatal("invalid legacy model")
+	}
+}
+
+func TestEnergyTimelinePowerChangesAndReads(t *testing.T) {
+	e := NewEnergyAnalyser()
+	if err := e.SetModel(testModel(), 0); err != nil {
+		t.Fatal(err)
+	}
+	e.AddNode(7, 0)
+	n := e.GetNode(7)
+	n.SetRadioState(RadioSleep, 1000000)
+	n.SetRadioState(RadioRx, 2000000)
+	// Test both event orders at the same timestamp: state, then frame power.
+	n.SetRadioState(RadioTx, 3000000)
+	n.SetTransmitPower(-20, 3000000)
+	e.Snapshot(3500000) // arbitrary intermediate reading must not change the integral
+	n.SetTransmitPower(0, 4000000)
+	s := e.Snapshot(6000000)
+	closeTo(t, s.DisabledJ, 0.0001)
+	closeTo(t, s.SleepJ, 0.001)
+	closeTo(t, s.RxJ, 0.005)
+	closeTo(t, s.TxJ, 0.070)
+	closeTo(t, s.TotalJ, 0.0761)
+	if !reflect.DeepEqual(s, e.Snapshot(6000000)) {
+		t.Fatal("repeated read changed energy")
+	}
+	if got := s.Nodes[0].StateTimesUS; got != (StateTimes{1000000, 1000000, 3000000, 1000000}) {
+		t.Fatalf("incorrect state durations: %+v", got)
+	}
+	// Reverse event order: a new physical power, then the TX state report.
+	n.SetRadioState(RadioRx, 6000000)
+	n.SetTransmitPower(-20, 7000000)
+	n.SetRadioState(RadioTx, 7000000)
+	s2 := e.Snapshot(8000000)
+	closeTo(t, s2.TxJ-s.TxJ, 0.010)
+	closeTo(t, s2.RxJ-s.RxJ, 0.005)
+}
+
+func TestSnapshotTotalsHistoryAndModelSwitch(t *testing.T) {
+	e := NewEnergyAnalyser()
+	empty := e.Snapshot(0)
+	if empty.TotalJ != 0 || empty.Nodes == nil {
+		t.Fatal("invalid empty snapshot")
+	}
+	if err := e.SetModel(testModel(), 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []int{8, 2} {
+		e.AddNode(id, 0)
+		e.GetNode(id).SetTransmitPower(-20, 0)
+		e.GetNode(id).SetRadioState(RadioTx, 0)
+	}
+	e.StoreNetworkEnergy(1000000)
+	m := testModel()
+	m.Tx[0].MW = 20
+	if err := e.SetModel(m, 1000000); err != nil {
+		t.Fatal(err)
+	}
+	m.Tx[0].MW = 999 // external mutation must not affect the active model
+	returned := e.Model()
+	returned.Tx[0].MW = 888
+	s := e.Snapshot(2000000)
+	closeTo(t, s.TotalJ, 0.060)
+	closeTo(t, e.energyHistoryByNodes[0][0].Tx, 10)  // snapshot not aliased to node
+	closeTo(t, e.networkHistory[0].EnergyConsTx, 10) // legacy mean in mJ
+	if s.Nodes[0].NodeID != 2 || s.Nodes[1].NodeID != 8 {
+		t.Fatal("unstable node order")
+	}
+	closeTo(t, s.TotalJ, s.Nodes[0].TotalJ+s.Nodes[1].TotalJ)
+	if s.ModelRevision != 3 {
+		t.Fatal("model revision not incremented")
+	}
+	bad := testModel()
+	bad.RxMW = -1
+	if e.SetModel(bad, 3000000) == nil {
+		t.Fatal("accepted bad model")
+	}
+	if e.Snapshot(2000000).ModelRevision != 3 {
+		t.Fatal("invalid load changed state")
+	}
+}
+
+func TestExportClosesOpenInterval(t *testing.T) {
+	// t.Chdir requires Go 1.24; project supports Go 1.23, so restore manually.
+	previous, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(t.TempDir()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chdir(previous); err != nil {
+			t.Error(err)
+		}
+	})
+	e := NewEnergyAnalyser()
+	if err := e.SetModel(testModel(), 0); err != nil {
+		t.Fatal(err)
+	}
+	e.AddNode(1, 0)
+	e.GetNode(1).SetRadioState(RadioRx, 0)
+	e.SaveEnergyDataToFile("check", 1234567)
+	closeTo(t, e.Snapshot(1234567).RxJ, 0.006172835)
+	data, err := os.ReadFile("energy_results/check_nodes.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), "6.172835") {
+		t.Fatalf("stale node export: %s", data)
+	}
+	data, err = os.ReadFile("energy_results/check.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), "1234\t") || !strings.Contains(string(data), "6.172835") {
+		t.Fatalf("stale network export: %s", data)
+	}
+	e.SaveEnergyDataToFile("check", 1234567)
+	if len(e.networkHistory) != 1 {
+		t.Fatal("duplicate history sample at same timestamp")
+	}
+}
+
+func TestLoadModel(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "model.json")
+	valid, _ := json.Marshal(testModel())
+	for _, data := range []string{string(valid), `{"name":"missing","tx":[{"dbm":0,"mw":1}]}`,
+		string(valid) + " {}", strings.Replace(string(valid), `"rx_mw"`, `"rx_typo"`, 1), "null",
+		strings.Replace(string(valid), `"dbm":-20,`, "", 1),
+		strings.Replace(string(valid), `"mw":10`, `"mw_typo":10`, 1)} {
+		if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+			t.Fatal(err)
+		}
+		_, err := LoadModel(path)
+		if data == string(valid) && err != nil {
+			t.Fatal(err)
+		}
+		if data != string(valid) && err == nil {
+			t.Fatalf("accepted invalid JSON: %s", data)
+		}
+	}
+}
