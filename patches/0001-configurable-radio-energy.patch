+"""Demonstrate fresh energy snapshots and per-node TX control (not an optimizer).
+
+Run from the OTNS repository root, using the updated simulator and pyOTNS.
+The supplied profile approximates typical TI CC2652R currents at 3 V.
+"""
+import json
+from pathlib import Path
+
+from otns.cli import OTNS
+
+
+def main():
+    repo = Path(__file__).resolve().parents[2]
+    ns = OTNS(otns_args=[
+        '-seed', '42', '-ot-cli',
+        str(repo / 'ot-rfsim/ot-versions/ot-cli-ftd'),
+    ])
+    try:
+        ns.energy_model(str(repo / 'etc/energy-lab-example.json'))
+        ns.radiomodel = 'MutualInterference'
+        ns.set_radioparam('ShadowFadingSigmaDb', 0)
+        ns.set_radioparam('TimeFadingSigmaMaxDb', 0)
+        for x in (0, 100):
+            ns.add('router', x=x, y=0, txpower=0)
+        ns.go(120)
+        for power in (5, 0, -10, -20):
+            for node in (1, 2):
+                ns.node_cmd(node, f'txpower {power}')
+            ns.go(60)  # common settling interval, outside the measurement
+            ns.pings()
+            before = ns.energy_snapshot()
+            ns.ping(1, 2, datasize=32, count=20, interval=1)
+            ns.go(30)
+            after = ns.energy_snapshot()
+            replies = ns.pings()
+            successful = sum(p[3] < ns.MAX_PING_DELAY for p in replies)
+            print(
+                json.dumps({
+                    'power_dbm':
+                    power,
+                    'model':
+                    after['model_name'],
+                    'window_s': (after['time_us'] - before['time_us']) / 1e6,
+                    'radio_energy_j':
+                    after['total_j'] - before['total_j'],
+                    'tx_energy_j':
+                    after['tx_j'] - before['tx_j'],
+                    'successful_ping_exchanges':
+                    successful,
+                    'attempted_ping_exchanges':
+                    20,
+                }))
+    finally:
+        ns.close()
+
+
+if __name__ == '__main__':
+    main()
