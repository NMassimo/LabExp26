+"""Energy integration tests against OTNS and existing OT-RFSIM binaries.
+
+Use OTNS=/path/to/patched/otns to select a binary under test.
+"""
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+from otns.cli import OTNS
+from otns.cli.errors import OTNSCliError
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+class EnergyTests(unittest.TestCase):
+
+    def setUp(self):
+        self.previous_cwd = os.getcwd()
+        self.directory = tempfile.TemporaryDirectory(prefix="otns-energy-")
+        os.chdir(self.directory.name)
+        self.ns = None
+
+    def tearDown(self):
+        if self.ns is not None:
+            self.ns.close()
+        os.chdir(self.previous_cwd)
+        self.directory.cleanup()
+
+    def start(self, power=-20, model="Ideal"):
+        self.ns = OTNS(sim_id=38,
+                       otns_args=[
+                           "-seed",
+                           "42",
+                           "-ot-cli",
+                           str(REPO / "ot-rfsim/ot-versions/ot-cli-ftd"),
+                           "-no-replay",
+                           "-pcap",
+                           "off",
+                           "-logfile",
+                           "off",
+                       ])
+        ns = self.ns
+        ns.radiomodel = model
+        if model == "MutualInterference":
+            ns.set_radioparam("ShadowFadingSigmaDb", 0)
+            ns.set_radioparam("TimeFadingSigmaMaxDb", 0)
+        ns.energy_model(str(REPO / "etc/energy-lab-example.json"))
+        for x in (0, 100):
+            ns.add("router", x=x, y=0, txpower=power)
+        ns.go(120)
+        return ns
+
+    def window(self):
+        ns = self.ns
+        before = ns.energy_snapshot()
+        ns.pings()
+        for _ in range(10):
+            ns.ping(1, 2, datasize=32)
+            ns.go(0.5)
+        ns.go(10.123456)
+        after = ns.energy_snapshot()
+        replies = ns.pings()
+        self.assertEqual(10, sum(p[3] < ns.MAX_PING_DELAY for p in replies))
+        self.assertEqual(15123456, after["time_us"] - before["time_us"])
+        return before, after
+
+    def assert_window(self, before, after, tx_mw):
+        self.assertEqual(after, self.ns.energy_snapshot())
+        self.assertAlmostEqual(after["total_j"],
+                               sum(n["total_j"] for n in after["nodes"]),
+                               places=12)
+        old = {n["node_id"]: n for n in before["nodes"]}
+        model = self.ns.energy_model()
+        for node in after["nodes"]:
+            previous = old[node["node_id"]]
+            for state in ("disabled", "sleep", "rx", "tx"):
+                duration = node["state_times_us"][state] - previous[
+                    "state_times_us"][state]
+                node_tx_mw = tx_mw[node["node_id"]] if isinstance(
+                    tx_mw, dict) else tx_mw
+                mw = node_tx_mw if state == "tx" else model[state + "_mw"]
+                self.assertAlmostEqual(node[state + "_j"] -
+                                       previous[state + "_j"],
+                                       duration * mw / 1e9,
+                                       places=12)
+            self.assertEqual(sum(node["state_times_us"].values()),
+                             after["time_us"])
+
+    def test_live_power_changes_and_export(self):
+        ns = self.start()
+        before, after = self.window()
+        self.assert_window(before, after, 13.8)
+        for i in (1, 2):
+            ns.node_cmd(i, "txpower 0")
+        # Changing a configuration without time advancing must not change past energy.
+        self.assertEqual(after, ns.energy_snapshot())
+        before, after = self.window()
+        self.assert_window(before, after, 21.0)
+        ns.cmd('energy save "current"')
+        lines = Path(
+            "energy_results/current_nodes.txt").read_text().splitlines()[2:]
+        by_id = {n["node_id"]: n for n in after["nodes"]}
+        for line in lines:
+            parts = line.split()
+            node = by_id[int(parts[0])]
+            for value, state in zip(parts[1:],
+                                    ("disabled", "sleep", "tx", "rx")):
+                self.assertAlmostEqual(float(value) / 1000,
+                                       node[state + "_j"],
+                                       places=8)
+        network_last_time_ms = int(
+            Path("energy_results/current.txt").read_text().splitlines()
+            [-1].split()[0])
+        self.assertEqual(network_last_time_ms, after["time_us"] // 1000)
+
+    def test_power_also_accounted_with_mutual_interference(self):
+        self.start(power=0, model="MutualInterference")
+        before, after = self.window()
+        self.assert_window(before, after, 21.0)
+
+    def test_per_node_power_including_ack_sender(self):
+        ns = self.start(power=-20)
+        ns.node_cmd(1, "txpower 0")
+        before, after = self.window()
+        self.assert_window(before, after, {1: 21.0, 2: 13.8})
+        for old, new in zip(before["nodes"], after["nodes"]):
+            self.assertGreater(new["state_times_us"]["tx"],
+                               old["state_times_us"]["tx"])
+
+    def test_same_airtime_different_electrical_energy(self):
+        windows = []
+        for power in (-20, 0):
+            self.start(power=power)
+            windows.append(self.window())
+            self.ns.close()
+            self.ns = None
+        (lo0, lo1), (hi0, hi1) = windows
+        lo_time = sum(b["state_times_us"]["tx"] - a["state_times_us"]["tx"]
+                      for a, b in zip(lo0["nodes"], lo1["nodes"]))
+        hi_time = sum(b["state_times_us"]["tx"] - a["state_times_us"]["tx"]
+                      for a, b in zip(hi0["nodes"], hi1["nodes"]))
+        self.assertGreater(lo_time, 0)
+        self.assertEqual(lo_time, hi_time)
+        self.assertAlmostEqual(
+            (hi1["tx_j"] - hi0["tx_j"]) / (lo1["tx_j"] - lo0["tx_j"]),
+            21 / 13.8,
+            places=10)
+
+    def test_model_validation_and_switch(self):
+        ns = self.start()
+        before = ns.energy_snapshot()
+        model = ns.energy_model()
+        path = Path('modello è "uno".json')
+        path.write_text(json.dumps(dict(model, rx_mw=-1)))
+        with self.assertRaises(OTNSCliError):
+            ns.energy_model(path)
+        self.assertEqual(before, ns.energy_snapshot())
+        path.write_text(
+            json.dumps(dict(model, name="changed", rx_mw=2 * model["rx_mw"])))
+        ns.energy_model(path)
+        after = ns.energy_snapshot()
+        self.assertEqual(after["total_j"], before["total_j"])
+        self.assertEqual(after["model_revision"], before["model_revision"] + 1)
+        self.assertEqual(after["model_name"], "changed")
+
+
+if __name__ == "__main__":
+    unittest.main()
