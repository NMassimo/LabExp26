 func (node *NodeEnergy) ComputeRadioState(timestamp uint64) {
+	logger.AssertTrue(timestamp >= node.radio.Timestamp, "energy time cannot move backwards")
 	delta := timestamp - node.radio.Timestamp
+	// mW * us / 1e6 = mJ. Accumulate using the OLD state and power;
+	// never reweight past transmissions when power or model changes.
+	duration := float64(delta) / 1e6
 	switch node.radio.State {
 	case RadioDisabled:
 		node.radio.SpentDisabled += delta
+		node.Disabled += duration * node.model.DisabledMW
 	case RadioSleep:
 		node.radio.SpentSleep += delta
+		node.Sleep += duration * node.model.SleepMW
 	case RadioTx:
 		node.radio.SpentTx += delta
+		node.Tx += duration * node.model.TxMW(node.txPowerDbm)
 	case RadioRx:
 		node.radio.SpentRx += delta
+		node.Rx += duration * node.model.RxMW
 	case RadioInvalid:
 		break // skip bookkeeping in this case
 	default:
@@ -60,15 +70,23 @@ func (node *NodeEnergy) ComputeRadioState(timestamp uint64) {
 	node.radio.Timestamp = timestamp
 }
 
