+package cli
+
+import "testing"
+
+func TestEnergyCommands(t *testing.T) {
+	for _, line := range []string{"energy", "energy save", `energy save "result"`, "energy snapshot", "energy model", `energy model "some path/model.json"`} {
+		var cmd Command
+		if err := parseBytes([]byte(line), &cmd); err != nil {
+			t.Fatalf("%s: %v", line, err)
+		}
+		if cmd.Energy == nil {
+			t.Fatalf("not an energy command: %s", line)
+		}
+		if line == `energy model "some path/model.json"` && cmd.Energy.Model.Path != "some path/model.json" {
+			t.Fatal("lost model path")
+		}
+	}
+	for _, line := range []string{`energy snapshot "ignored"`, "energy nonsense", `energy model "a" "b"`} {
+		var cmd Command
+		if parseBytes([]byte(line), &cmd) == nil {
+			t.Fatalf("accepted %s", line)
+		}
+	}
+}
