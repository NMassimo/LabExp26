+package energy
+
+import "sort"
+
+// EnergyValues uses joules. Existing GUI and text exports continue using mJ.
+type EnergyValues struct {
+	DisabledJ float64 `json:"disabled_j"`
+	SleepJ    float64 `json:"sleep_j"`
+	TxJ       float64 `json:"tx_j"`
+	RxJ       float64 `json:"rx_j"`
+	TotalJ    float64 `json:"total_j"`
+}
+
+type StateTimes struct {
+	Disabled uint64 `json:"disabled"`
+	Sleep    uint64 `json:"sleep"`
+	Tx       uint64 `json:"tx"`
+	Rx       uint64 `json:"rx"`
+}
+
+type NodeSnapshot struct {
+	NodeID int `json:"node_id"`
+	EnergyValues
+	StateTimesUS StateTimes `json:"state_times_us"`
+}
+
+// Snapshot totals include current nodes only. Removing nodes changes this scope.
+type Snapshot struct {
+	SchemaVersion int    `json:"schema_version"`
+	TimeUS        uint64 `json:"time_us"`
+	ModelName     string `json:"model_name"`
+	ModelRevision uint64 `json:"model_revision"`
+	Scope         string `json:"scope"`
+	EnergyValues
+	Nodes []NodeSnapshot `json:"nodes"`
+}
+
+// Snapshot closes open intervals at the requested simulation time without
+// appending history samples. Call on the simulation dispatcher, like other
+// analyser mutations; repeated reads at the same timestamp consume no energy.
+func (e *EnergyAnalyser) Snapshot(timestamp uint64) Snapshot {
+	s := Snapshot{SchemaVersion: 1, TimeUS: timestamp, ModelName: e.model.Name,
+		ModelRevision: e.modelRevision, Scope: "current_nodes", Nodes: make([]NodeSnapshot, 0, len(e.nodes))}
+	ids := make([]int, 0, len(e.nodes))
+	for id := range e.nodes {
+		ids = append(ids, id)
+	}
+	sort.Ints(ids)
+	for _, id := range ids {
+		node := e.nodes[id]
+		node.ComputeRadioState(timestamp)
+		v := EnergyValues{DisabledJ: node.Disabled / 1000, SleepJ: node.Sleep / 1000,
+			TxJ: node.Tx / 1000, RxJ: node.Rx / 1000}
+		v.TotalJ = v.DisabledJ + v.SleepJ + v.TxJ + v.RxJ
+		s.Nodes = append(s.Nodes, NodeSnapshot{NodeID: id, EnergyValues: v,
+			StateTimesUS: StateTimes{node.radio.SpentDisabled, node.radio.SpentSleep, node.radio.SpentTx, node.radio.SpentRx}})
+		s.DisabledJ += v.DisabledJ
+		s.SleepJ += v.SleepJ
+		s.TxJ += v.TxJ
+		s.RxJ += v.RxJ
+		s.TotalJ += v.TotalJ
+	}
+	return s
+}
+
+// Model returns a copy so callers cannot silently reweight open intervals.
+func (e *EnergyAnalyser) Model() Model {
+	m := *e.model
+	m.Tx = append([]TxPoint(nil), m.Tx...)
+	return m
+}
+
+// SetModel preserves past energy and applies new coefficients prospectively.
+func (e *EnergyAnalyser) SetModel(model Model, timestamp uint64) error {
+	if err := model.Validate(); err != nil {
+		return err
+	}
+	model.Tx = append([]TxPoint(nil), model.Tx...)
+	for _, node := range e.nodes {
+		node.ComputeRadioState(timestamp)
+		node.model = &model
+	}
+	e.model = &model
+	e.modelRevision++
+	return nil
+}
