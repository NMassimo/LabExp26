+package energy
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+)
+
+// TxPoint maps radiated RF power (dBm) to electrical power consumption (mW).
+type TxPoint struct {
+	DBm int     `json:"dbm"`
+	MW  float64 `json:"mw"`
+}
+
+func (point *TxPoint) UnmarshalJSON(data []byte) error {
+	var fields struct {
+		DBm *int     `json:"dbm"`
+		MW  *float64 `json:"mw"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&fields); err != nil {
+		return err
+	}
+	if fields.DBm == nil || fields.MW == nil {
+		return fmt.Errorf("each TX point requires dbm and mw")
+	}
+	point.DBm, point.MW = *fields.DBm, *fields.MW
+	return nil
+}
+
+// Model describes radio electrical consumption, not CPU or whole-board power.
+// TX values are linearly interpolated in dBm; values outside the table are
+// clamped to its endpoints. A one-point table specifies constant consumption.
+type Model struct {
+	Name       string    `json:"name"`
+	DisabledMW float64   `json:"disabled_mw"`
+	SleepMW    float64   `json:"sleep_mw"`
+	RxMW       float64   `json:"rx_mw"`
+	Tx         []TxPoint `json:"tx"`
+}
+
+// LegacyModel is the constant-consumption OTNS default.
+func LegacyModel() Model {
+	return Model{
+		Name: "legacy-constant", DisabledMW: RadioDisabledConsumption * 1e6,
+		SleepMW: RadioSleepConsumption * 1e6, RxMW: RadioRxConsumption * 1e6,
+		Tx: []TxPoint{{DBm: 0, MW: RadioTxConsumption * 1e6}},
+	}
+}
+
+func (m Model) Validate() error {
+	if m.Name == "" || len(m.Tx) == 0 {
+		return fmt.Errorf("energy model requires a name and a nonempty TX table")
+	}
+	values := []float64{m.DisabledMW, m.SleepMW, m.RxMW}
+	for i, point := range m.Tx {
+		if point.DBm < -128 || point.DBm > 127 || (i > 0 && point.DBm <= m.Tx[i-1].DBm) {
+			return fmt.Errorf("TX dBm values must be strictly increasing and in [-128, 127]")
+		}
+		values = append(values, point.MW)
+	}
+	for _, value := range values {
+		if value < 0 || math.IsNaN(value) || math.IsInf(value, 0) {
+			return fmt.Errorf("energy consumption must be finite and nonnegative")
+		}
+	}
+	return nil
+}
+
+func (m Model) TxMW(dbm int8) float64 {
+	power := int(dbm)
+	if power <= m.Tx[0].DBm {
+		return m.Tx[0].MW
+	}
+	for i := 1; i < len(m.Tx); i++ {
+		if power <= m.Tx[i].DBm {
+			lo, hi := m.Tx[i-1], m.Tx[i]
+			return lo.MW + (hi.MW-lo.MW)*float64(power-lo.DBm)/float64(hi.DBm-lo.DBm)
+		}
+	}
+	return m.Tx[len(m.Tx)-1].MW
+}
+
+// LoadModel rejects misspelled/unknown fields and trailing JSON documents.
+func LoadModel(path string) (Model, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return Model{}, err
+	}
+	defer f.Close()
+	// NaN sentinels distinguish omitted/null state powers from explicit zero.
+	m := Model{DisabledMW: math.NaN(), SleepMW: math.NaN(), RxMW: math.NaN()}
+	decoder := json.NewDecoder(f)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&m); err != nil {
+		return Model{}, err
+	}
+	if err := decoder.Decode(new(interface{})); err != io.EOF {
+		return Model{}, fmt.Errorf("unexpected data after energy model")
+	}
+	return m, m.Validate()
+}
